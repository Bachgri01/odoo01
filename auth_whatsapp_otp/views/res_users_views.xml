<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_whatsapp_otp" model="ir.ui.view">
        <field name="name">res.users.form.whatsapp.otp</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="WhatsApp Auth" name="whatsapp_auth">
                    <group>
                        <field name="whatsapp_2fa_enabled"/>
                        <field name="mobile" readonly="0"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
