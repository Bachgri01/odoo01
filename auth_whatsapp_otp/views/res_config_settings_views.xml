<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.auth.whatsapp.otp</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="WhatsApp OTP" string="WhatsApp OTP" data-key="auth_whatsapp_otp">
                    <h2>WhatsApp OTP Configuration (UltraMsg)</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ultramsg_instance_id"/>
                                <div class="text-muted">
                                    Your UltraMsg Instance ID
                                </div>
                                <field name="ultramsg_instance_id"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ultramsg_token"/>
                                <div class="text-muted">
                                    Your UltraMsg Token
                                </div>
                                <field name="ultramsg_token" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="whatsapp_otp_expiry_minutes"/>
                                <div class="text-muted">
                                    OTP validity period in minutes
                                </div>
                                <field name="whatsapp_otp_expiry_minutes"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_whatsapp_otp_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'auth_whatsapp_otp'}</field>
    </record>
</odoo>
