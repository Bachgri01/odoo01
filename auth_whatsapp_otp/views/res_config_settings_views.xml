<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.auth.whatsapp.otp</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="WhatsApp OTP" string="WhatsApp OTP" data-key="auth_whatsapp_otp">
                    <h2>WhatsApp OTP Configuration</h2>
                    
                    <!-- Gateway Selection -->
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="whatsapp_gateway"/>
                                <div class="text-muted">Choose your WhatsApp gateway provider</div>
                                <field name="whatsapp_gateway" required="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- UltraMsg Configuration -->
                    <div class="row mt16 o_settings_container" attrs="{'invisible': [('whatsapp_gateway', '!=', 'ultramsg')]}">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ultramsg_instance_id"/>
                                <field name="ultramsg_instance_id" attrs="{'required': [('whatsapp_gateway', '==', 'ultramsg')]}"/>
                                <label for="ultramsg_token" class="mt16"/>
                                <field name="ultramsg_token" password="True" attrs="{'required': [('whatsapp_gateway', '==', 'ultramsg')]}"/>
                            </div>
                        </div>
                    </div>

                    <!-- Twilio Configuration -->
                    <div class="row mt16 o_settings_container" attrs="{'invisible': [('whatsapp_gateway', '!=', 'twilio')]}">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="twilio_account_sid"/>
                                <field name="twilio_account_sid" attrs="{'required': [('whatsapp_gateway', '==', 'twilio')]}"/>
                                <label for="twilio_auth_token" class="mt16"/>
                                <field name="twilio_auth_token" password="True" attrs="{'required': [('whatsapp_gateway', '==', 'twilio')]}"/>
                                <label for="twilio_phone_number" class="mt16"/>
                                <field name="twilio_phone_number" attrs="{'required': [('whatsapp_gateway', '==', 'twilio')]}"/>
                                <div class="text-muted small">Example: whatsapp:+14155238886</div>
                            </div>
                        </div>
                    </div>

                    <!-- Infobip Configuration -->
                    <div class="row mt16 o_settings_container" attrs="{'invisible': [('whatsapp_gateway', '!=', 'infobip')]}">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="infobip_base_url"/>
                                <field name="infobip_base_url" attrs="{'required': [('whatsapp_gateway', '==', 'infobip')]}"/>
                                <label for="infobip_api_key" class="mt16"/>
                                <field name="infobip_api_key" password="True" attrs="{'required': [('whatsapp_gateway', '==', 'infobip')]}"/>
                                <label for="infobip_sender" class="mt16"/>
                                <field name="infobip_sender" attrs="{'required': [('whatsapp_gateway', '==', 'infobip')]}"/>
                            </div>
                        </div>
                    </div>

                    <!-- MessageBird Configuration -->
                    <div class="row mt16 o_settings_container" attrs="{'invisible': [('whatsapp_gateway', '!=', 'messagebird')]}">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="messagebird_api_key"/>
                                <field name="messagebird_api_key" password="True" attrs="{'required': [('whatsapp_gateway', '==', 'messagebird')]}"/>
                                <label for="messagebird_channel_id" class="mt16"/>
                                <field name="messagebird_channel_id" attrs="{'required': [('whatsapp_gateway', '==', 'messagebird')]}"/>
                            </div>
                        </div>
                    </div>

                    <!-- Meta Cloud API Configuration -->
                    <div class="row mt16 o_settings_container" attrs="{'invisible': [('whatsapp_gateway', '!=', 'meta')]}">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="meta_api_token"/>
                                <field name="meta_api_token" password="True" attrs="{'required': [('whatsapp_gateway', '==', 'meta')]}"/>
                                <label for="meta_phone_number_id" class="mt16"/>
                                <field name="meta_phone_number_id" attrs="{'required': [('whatsapp_gateway', '==', 'meta')]}"/>
                                <div class="text-muted small">Available in Meta for Developers dashboard.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Common Settings -->
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="whatsapp_otp_expiry_minutes"/>
                                <div class="text-muted">OTP validity period in minutes</div>
                                <field name="whatsapp_otp_expiry_minutes"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_whatsapp_otp_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'auth_whatsapp_otp'}</field>
    </record>
</odoo>
